    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,md,json,css}\""
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
