{
  "name": "9ent-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,md,json,css}\""
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^7.9.1",
    "next": "15",
    "react": "19",
    "react-dom": "19",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "8",
    "eslint-config-next": "15",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "3",
    "tsx": "^4.23.6",
    "typescript": "^6.0.3"
  }
