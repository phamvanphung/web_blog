generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// USERS + AUTH
// ============================================================

enum UserRole {
  ADMIN
  EDITOR
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  passwordHash  String
  role          UserRole   @default(EDITOR)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  posts             Post[]               @relation("PostAuthor")
  pages             Page[]
  media             Media[]
  postRevisions     PostRevision[]
  sessions          Session[]
  auditLogs         AuditLog[]
  contactActions    ContactSubmission[] @relation("ContactAssignedTo")

  @@index([role])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  userAgent   String?  @db.VarChar(500)
  ipHash      String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// CONTENT
// ============================================================

enum PostStatus {
  DRAFT
  PENDING
  SCHEDULED
  PUBLISHED
  HIDDEN
  TRASHED
}

model Post {
  id                String      @id @default(cuid())
  title             String      @db.VarChar(255)
  slug              String      @unique @db.VarChar(255)
  excerpt           String?     @db.Text
  contentJson       Json
  contentHtml       String      @db.LongText
  contentText       String      @db.LongText
  featuredMediaId   String?
  featuredMedia     Media?      @relation("PostFeatured", fields: [featuredMediaId], references: [id], onDelete: SetNull)
  authorId          String
  author            User        @relation("PostAuthor", fields: [authorId], references: [id])
  status            PostStatus  @default(DRAFT)
  allowComments     Boolean     @default(false)
  isFeatured        Boolean     @default(false)
  publishedAt       DateTime?
  scheduledAt       DateTime?
  seoTitle          String?     @db.VarChar(255)
  seoDescription    String?     @db.VarChar(500)
  canonicalUrl      String?     @db.VarChar(500)
  viewsCount        Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  revisions         PostRevision[]
  categories        PostCategory[]
  tags              PostTag[]
  redirects         Redirect[]  @relation("RedirectToPost")

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([deletedAt])
  @@index([deletedAt, status, publishedAt])
  @@index([status, updatedAt])
  @@index([isFeatured, status, publishedAt])
  @@fulltext([title, excerpt, contentText])
}

model PostRevision {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title       String
  contentJson Json
  editorId    String
  editor      User     @relation(fields: [editorId], references: [id])
  createdAt   DateTime @default(now())

  @@index([postId, createdAt])
}

enum PageStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

model Page {
  id              String     @id @default(cuid())
  title           String     @db.VarChar(255)
  slug            String     @unique @db.VarChar(255)
  content         String     @db.LongText    // deprecated — derived server-side from sections
  sections        Json?                        // Section[] (see modules/pages/types.ts)
  status          PageStatus @default(DRAFT)
  seoTitle        String?    @db.VarChar(255)
  seoDescription  String?    @db.VarChar(500)
  authorId        String
  author          User       @relation(fields: [authorId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  redirects       Redirect[] @relation("RedirectToPage")

  @@index([status])
  @@index([status, updatedAt])
}

// ============================================================
// TAXONOMY
// ============================================================

model CategoryGroup {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  sortOrder   Int      @default(0)
  isProtected Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories  Category[]

  @@index([sortOrder])
}

model Category {
  id             String     @id @default(cuid())
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[] @relation("CategoryTree")
  name           String     @db.VarChar(120)
  slug           String     @unique @db.VarChar(120)
  description    String?    @db.Text
  imageMediaId   String?
  imageMedia     Media?     @relation("CategoryImage", fields: [imageMediaId], references: [id], onDelete: SetNull)
  sortOrder      Int        @default(0)
  seoTitle       String?    @db.VarChar(255)
  seoDescription String?    @db.VarChar(500)
  groupId        String?
  group          CategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  hidden         Boolean        @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  posts          PostCategory[]

  @@index([parentId])
  @@index([groupId, hidden])
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(80)
  slug      String   @unique @db.VarChar(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

// ============================================================
// MEDIA
// ============================================================

model Media {
  id           String   @id @default(cuid())
  originalName String   @db.VarChar(255)
  storedName   String   @unique @db.VarChar(255)
  path         String   @db.VarChar(500)
  url          String   @db.VarChar(500)
  mimeType     String   @db.VarChar(80)
  fileSize     Int
  width        Int?
  height       Int?
  altText      String?  @db.VarChar(255)
  caption      String?  @db.VarChar(500)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  posts        Post[]     @relation("PostFeatured")
  categories   Category[] @relation("CategoryImage")

  @@index([mimeType])
  @@index([createdAt])
}

// ============================================================
// MENUS
// ============================================================

model Menu {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(80)
  location  String?  @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     MenuItem[]

  @@index([location])
}

enum MenuItemType {
  PAGE
  POST
  CATEGORY
  EXTERNAL
}

model MenuItem {
  id          String       @id @default(cuid())
  menuId      String
  menu        Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      MenuItem?    @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[]   @relation("MenuItemTree")
  label       String       @db.VarChar(120)
  type        MenuItemType
  targetId    String?
  externalUrl String?      @db.VarChar(500)
  openInNew   Boolean      @default(false)
  sortOrder   Int          @default(0)
  isVisible   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([menuId, parentId])
  @@index([sortOrder])
}

// ============================================================
// SETTINGS (key-value)
// ============================================================

model Setting {
  key       String   @id @db.VarChar(80)
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
}

// ============================================================
// REDIRECTS
// ============================================================

model Redirect {
  id          String   @id @default(cuid())
  fromPath    String   @unique @db.VarChar(500)
  toPath      String   @db.VarChar(500)
  postId      String?
  post        Post?    @relation("RedirectToPost", fields: [postId], references: [id], onDelete: SetNull)
  pageId      String?
  page        Page?    @relation("RedirectToPage", fields: [pageId], references: [id], onDelete: SetNull)
  statusCode  Int      @default(301)
  createdAt   DateTime @default(now())
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(80)
  target    String?  @db.VarChar(80)
  targetId  String?  @db.VarChar(40)
  metadata  Json?
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

// ============================================================
// NEWSLETTER
// ============================================================

model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(200)
  ipHash    String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============================================================
// CONTACT (defer comments)
// ============================================================

enum ContactStatus {
  NEW
  READ
  ARCHIVED
}

model ContactSubmission {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(120)
  email        String        @db.VarChar(200)
  phone        String?       @db.VarChar(40)
  subject      String?       @db.VarChar(200)
  message      String        @db.Text
  status       ContactStatus @default(NEW)
  ipHash       String?       @db.VarChar(64)
  userAgent    String?       @db.VarChar(500)
  assignedToId String?
  assignedTo   User?         @relation("ContactAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

// ============================================================
// POPUPS
// ============================================================

enum PopupStatus {
  DRAFT
  PUBLISHED
}

enum PopupTriggerType {
  ALL
  HOMEPAGE
  PATH
}

enum PopupFrequency {
  ALWAYS
  ONCE
}

model Popup {
  id            String           @id @default(cuid())
  name          String           @db.VarChar(120)
  htmlContent   String           @db.LongText
  triggerType   PopupTriggerType @default(ALL)
  triggerPaths  Json?
  frequency     PopupFrequency   @default(ONCE)
  delaySeconds  Int              @default(0)
  status        PopupStatus      @default(DRAFT)
  notes         String?          @db.VarChar(500)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  @@index([status, triggerType])
  @@index([deletedAt])
}
