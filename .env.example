# =============================================================================
# .env.example — Template cho .env thật
# =============================================================================
#
# Copy file này thành `.env` và điền giá trị thật:
#     cp .env.example .env
#
# Quy tắc:
#   - KHÔNG commit `.env` (đã được `.gitignore`).
#   - Mọi giá trị có chứa `CHANGE_ME` hoặc `change-me-...` đều là placeholder
#     bắt buộc phải thay.
#   - Production phải override TẤT CẢ các giá trị dev mặc định dưới đây.
#
# =============================================================================
# 1. DATABASE — Prisma 7 + MySQL 8 (mariadb driver)
# =============================================================================
#
# Connection string cho Prisma. Project dùng @prisma/adapter-mariadb nên URL
# phải có dạng `mysql://user:pass@host:port/dbname`.
#
# - Dev (Windows Docker):
#     mysql://9ent:localpass@localhost:3306/9ent_blog
# - Dev (Linux local / socket — không dùng port):
#     mysql://9ent:localpass@/9ent_blog?unix_socket=/var/run/mysqld/mysqld.sock
# - Production (VPS): user phải là user riêng có GRANT giới hạn — KHÔNG dùng `root`.
#
# Lưu ý ký tự đặc biệt trong password phải URL-encode:
#   `@`  → %40     `:` → %3A     `/` → %2F     `#` → %23
DATABASE_URL="mysql://9ent:CHANGE_ME@localhost:3306/9ent_blog"


# =============================================================================
# 2. APP — Runtime + canonical site URL
# =============================================================================

# NODE_ENV: do Next.js tự set qua `next dev` / `next start`, nhưng có thể pin
# thẳng trong env để các script `tsx prisma/seed.ts` chạy đúng context.
# Giá trị: "development" | "production" | "test"
NODE_ENV="development"

# APP_URL: canonical URL của site — dùng cho sitemap, robots, RSS, JSON-LD
# (publisher logo), OpenGraph absolute URL, email link, v.v.
# Bắt buộc KHÔNG có trailing slash (code đã tự strip).
# - Dev:    http://localhost:3000
# - Prod:   https://9ent.vn  (HTTPS bắt buộc cho SEO + cookies Secure)
APP_URL="http://localhost:3000"

# NEXT_PUBLIC_SITE_URL: optional override cho JSON-LD WebPage URL builder.
# Hầu hết code dùng APP_URL ở server-side là đủ — biến này chỉ cần khi bạn
# muốn JSON-LD `<script type="application/ld+json">` render URL KHÁC với
# canonical (ví dụ: serve CDN domain trên production). Để trống = dùng fallback.
# Biến có prefix `NEXT_PUBLIC_` nên KHẢ DỤNG cả ở client bundle.
NEXT_PUBLIC_SITE_URL="https://example.com"


# =============================================================================
# 3. AUTH & SESSION — Session cookie `sid` + Argon2id + IP pepper
# =============================================================================
#
# Session storage trong DB table `Session`. Cookie HttpOnly + SameSite=Lax,
# Secure chỉ bật khi NODE_ENV=production (xem modules/auth/server/session.ts).
#

# Tên cookie session. Đổi nếu chạy nhiều instance cùng domain và muốn tránh
# đụng session nhau. Mặc định "sid" đã đủ cho single-instance.
SESSION_COOKIE_NAME="sid"

# TTL session tính theo NGÀY. Session row bị xoá khi expired (lazy cleanup
# trong readSession). Production khuyến nghị 7–30 ngày tuỳ policy.
SESSION_TTL_DAYS="14"

# SESSION_IP_PEPPER: secret dùng để hash IP user trước khi lưu vào
# Session.ipHash (audit log + brute-force detection). KHÔNG rotate nếu không
# cần — rotation sẽ làm vô hiệu hoá toàn bộ session hiện tại.
# Generate giá trị thật (64 hex chars):
#     node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_IP_PEPPER="change-me-to-32+-random-chars"

# Admin mặc định seed bởi prisma/seed.ts. 2 biến này chỉ dùng cho SEED — sau
# khi login lần đầu, đổi password qua /admin/users (UI có ở P5+).
# Nếu KHÔNG set: mặc định "admin@9ent.vn" / "changeme123!" — KHÔNG dùng ở prod.
SEED_ADMIN_EMAIL="admin@9ent.vn"
SEED_ADMIN_PASSWORD="changeme123!"


# =============================================================================
# 4. STORAGE — Local filesystem (uploads serve qua route handler dev / Nginx prod)
# =============================================================================
#
# Cross-platform: UPLOAD_ROOT là relative path → resolve qua path.resolve(cwd, raw).
# Production: dùng absolute path "/srv/9ent/storage/uploads".
#
# Public URL format: {UPLOAD_PUBLIC_BASE}/YYYY/MM/<uuid>-<variant>.webp
#

# Thư mục gốc lưu file upload. Đường dẫn relative ("./storage/uploads") chạy
# được cả Windows lẫn Linux; production đổi thành absolute path theo OS.
# Thư mục phải tồn tại + writable. Commit `.gitkeep` để giữ structure.
UPLOAD_ROOT="./storage/uploads"

# URL prefix để build public URL cho uploaded file.
# - Dev:  relative "/uploads" → serve qua app/uploads/[...path]/route.ts
# - Prod: relative "/uploads" → Nginx serve static trực tiếp từ UPLOAD_ROOT
# KHÔNG thêm absolute URL / domain ở đây (sẽ sinh ra absolute URL trong HTML —
# dùng APP_URL cho mục đích đó).
UPLOAD_PUBLIC_BASE="/uploads"


# =============================================================================
# 5. LOGGING — Minimal structured logger (lib/logger.ts)
# =============================================================================

# Ngưỡng log: "debug" | "info" | "warn" | "error".
# - Dev:  "debug" (verbose)
# - Prod: "info" (mặc định) hoặc "warn" (quiet)
# Output format: NODE_ENV=production → JSON một dòng; ngược lại pretty-print.
LOG_LEVEL="info"


# =============================================================================
# 6. SCRIPTS & TESTING — Optional, chỉ phục vụ verify-*.mjs + Playwright
# =============================================================================

# BASE_URL: target URL cho scripts/verify-*.mjs (manual QA scripts).
# Mặc định port 3016 = port dùng khi chạy `pnpm dev` thủ công cho manual test.
# Thường KHÔNG cần set — chỉ override khi test trên staging/prod URL.
BASE_URL="http://localhost:3016"

# CI: cờ chuẩn do GitHub Actions / GitLab CI / CircleCI tự set = "true".
# - Khi set: Playwright retries=2, reporter=github, forbidOnly=true (fail nếu
#   còn `.only`); webServer reuseExistingServer=false.
# - Khi unset (local): retries=0, reporter=list, allow .only, reuse server.
# KHÔNG set thủ công trong `.env` local — để CI provider tự inject.
# CI=""